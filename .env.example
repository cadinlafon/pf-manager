# PF Management runs without any environment variables; these are optional.
# Copy this file to .env to change them.
#
# The Firebase web config lives in src/firebase/config.js, the same way the
# PF Audio App keeps it in src/firebase.js. Those values identify the Firebase
# project to the browser; they are not secrets.
#
# Never put service-account keys or other private credentials in this project.

# Local UI preview without signing in (development server only, ignored in
# production builds). `npm run dev:preview` sets this for you.
# VITE_AUTH_PREVIEW=1

# Base address used in invitation links. Defaults to wherever the app is open,
# so set this once PF Management has a real address.
# VITE_APP_URL=https://leaders.example.com

# Finance page: true = on, false = shown in the menu as "Unavailable" and
# can't be opened. Restart the dev server (or rebuild) after changing.
VITE_FINANCE_ENABLED=true
